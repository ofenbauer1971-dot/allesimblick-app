{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allesimblick-reminder",
  "main": "worker.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://ofenbauer1971-dot.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "allesimblick-reminders",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
